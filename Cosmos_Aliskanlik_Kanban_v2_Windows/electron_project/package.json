{
  "name": "aliskanlik-takip-paneli",
  "version": "2.0.0",
  "description": "COSMOS OS - Alışkanlık, Aylık/Yıllık Telemetri ve Proje Kanban Masaüstü Uygulaması",
  "author": "Ahmet Demir",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.ahmet.habittracker",
    "productName": "AliskanlikTakip",
    "files": [
      "main.js",
      "AliskanlikTakip.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
