{
  "name": "aliskanlik-takip-paneli",
  "version": "2.1.0",
  "description": "Cosmos - Space-themed habit tracker, Kanban project board and analytics desktop app",
  "author": "Ahmet Demir",
  "license": "Apache-2.0",
  "homepage": "https://github.com/11R5/cosmos-productivity-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/11R5/cosmos-productivity-hub.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.input.css -o src/vendor/tailwind.css --minify",
    "icon": "electron scripts/icon.js",
    "screenshots": "electron scripts/screenshots.js",
    "build:win": "npm run build:css && electron-builder --win",
    "build:mac": "npm run build:css && electron-builder --mac",
    "build:linux": "npm run build:css && electron-builder --linux"
  },
  "build": {
    "appId": "com.ahmet.habittracker",
    "productName": "Cosmos",
    "artifactName": "Cosmos-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "src/index.html",
      "src/vendor/**/*",
      "src/assets/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Cosmos-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cosmos-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "11R5 <https://github.com/11R5>",
      "synopsis": "Habit tracker, Kanban board and analytics"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "chart.js": "4.5.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "lucide": "1.59.0",
    "tailwindcss": "3.4.19"
  }
}
